{
  "name": "car-rental-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade B2B SaaS and white-label car rental platform backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/migrations/runner.js up",
    "db:rollback": "node src/migrations/runner.js down",
    "test": "node --test tests/auth/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.4",
    "nodemailer": "10.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
